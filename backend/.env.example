DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/todoapp
CORS_ALLOWED_ORIGINS=http://localhost:8081
AUTH_JWT_SECRET=change-me-to-a-random-secret
AUTH_COOKIE_SECURE=false
# password reset link lifetime (ISO-8601 duration or seconds)
AUTH_PASSWORD_RESET_TOKEN_EXP=PT1H
# password policy: low (>=8), medium (>=12, ASVS baseline), high (>=15, NIST)
AUTH_PASSWORD_STRENGTH=medium
# max accepted password length; must be >= 64 (ASVS 2.1.2)
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_PASSWORD_CHECK_PWNED=true
AUTH_RATE_LIMIT_ENABLED=true
REDIS_URL=redis://localhost:6379
MAIL_CELERY_BROKER_URL=redis://localhost:6379/1
MAIL_CELERY_RESULT_BACKEND=redis://localhost:6379/1
MAIL_FROM_EMAIL=no-reply@todoapp.local
MAIL_PROVIDER=smtp
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_API_BASE_URL=http://localhost:8000
MAIL_FRONTEND_BASE_URL=http://localhost:8081

