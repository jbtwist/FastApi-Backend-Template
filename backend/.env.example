# Boostrap configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/todoapp
API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
JWT_SECRET=change-me-to-a-random-secret
COOKIE_SECURE=false
# Logging configuration
LOG_LEVEL=INFO
# console for local dev, json for anything that ships logs
LOG_FORMAT=console
# Password policy configuration
PASSWORD_CHECK_PWNED=true
# password reset link lifetime (ISO-8601 duration or seconds)
PASSWORD_RESET_TOKEN_EXP=PT1H
# password policy: low (>=8), medium (>=12, ASVS baseline), high (>=15, NIST)
PASSWORD_STRENGTH=medium
# max accepted password length; must be >= 64 (ASVS 2.1.2)
PASSWORD_MAX_LENGTH=128
# Redis and Celery configuration
RATE_LIMIT_ENABLED=true
REDIS_URL=redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Email configuration
FROM_EMAIL=no-reply@todoapp.local
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# OAuth provider sign-in: with no provider enabled the app runs with password sign-in only
# comma-separated adapter names, each a module under src/backend/auth/oauth/providers/
# OAUTH_ENABLED_PROVIDERS=google,apple
# sign-in attempt lifetime (ISO-8601 duration or seconds)
# OAUTH_STATE_TTL=600
# how long an emailed "link this provider to your account" link stays valid
# OAUTH_LINK_TOKEN_EXP=PT1H
# Google: one client ID per platform; the secret is used by the web redirect flow only
# GOOGLE_CLIENT_ID_WEB=
# GOOGLE_CLIENT_ID_IOS=
# GOOGLE_CLIENT_ID_ANDROID=
# GOOGLE_CLIENT_SECRET=
# Apple: team ID, Services ID (web), bundle ID (native), and the .p8 key's ID and contents
# APPLE_TEAM_ID=
# APPLE_SERVICES_ID=
# APPLE_BUNDLE_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

