# Local overrides for docker-compose.yml, which defaults to production-safe
# values and leaves secrets unset. Use with docker-compose.local.yml:
#
#   docker compose -f docker-compose.yml -f docker-compose.local.yml \
#     --env-file deploy/local.env up --build
#
# None of these values belong anywhere reachable from the internet.

# The postgres and redis services bundled by docker-compose.local.yml.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/backend_template
POSTGRES_PASSWORD=postgres
REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/1

API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

JWT_SECRET=dev-only-secret-not-for-any-deployed-environment
# No TLS in front of the local stack, so a Secure cookie would never be sent.
COOKIE_SECURE=false
LOG_FORMAT=console

# mailpit catches everything; read it at http://localhost:8025
FROM_EMAIL=no-reply@backend-template.local
EMAIL_PROVIDER=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025

# uvicorn's peer is the nginx container, whose IP is assigned by Docker and so
# cannot be named ahead of time. A real deployment names its load balancer.
FORWARDED_ALLOW_IPS=*
