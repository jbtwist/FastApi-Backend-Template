{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "react", "react-native", "jest"]
  },
  "include": [
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "css-modules.d.ts",
    "jest-setup.ts",
    "src/test-utils/**/*.ts",
    "src/test-utils/**/*.tsx",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  // `exclude` is inherited, and it filters `include` — without this override the
  // base config's "**/*.test.ts(x)" strips out every file this project exists to
  // check, and `tsc` passes by checking nothing.
  "exclude": ["node_modules"]
}
