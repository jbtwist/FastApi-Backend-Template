{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Keep the jest ambient globals out of app code — `describe` / `expect` in a
    // module under src/ should be a type error, not silently valid. Test files
    // pick jest back up via tsconfig.test.json.
    "types": ["node", "react", "react-native"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
