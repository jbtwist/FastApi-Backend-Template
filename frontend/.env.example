# Base URL of the backend `/auth` API. Copy this file to `.env` to override.
EXPO_PUBLIC_API_URL=http://localhost:8000

# Password bounds enforced by the form before it submits. Must match the
# backend, whose floor comes from the `PASSWORD_STRENGTH` tier
# (low = 8, medium = 12, high = 15) and whose ceiling is `PASSWORD_MAX_LENGTH`.
# A password that clears both can only be rejected for having been breached,
# which is what lets the app name the reason in the user's own language.
# These are inlined at bundle time: rebuild after changing them.
EXPO_PUBLIC_PASSWORD_MIN_LENGTH=12
EXPO_PUBLIC_PASSWORD_MAX_LENGTH=128
