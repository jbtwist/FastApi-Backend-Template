# Expo SDK 57 + jest-expo: react-native 0.86.2 pins `@react-native/jest-preset`
# as an optional peer at 0.86.2 while jest-expo needs ^0.86.3. The mismatch is
# benign; `npx expo install` already resolves this way. Keep npm from failing on it.
legacy-peer-deps=true

# Supply-chain hardening. See
# docs/architecture/decisions/0006-harden-npm-installs-over-pnpm.md
#   ignore-scripts  - never run a dependency's preinstall/install/postinstall/
#                     prepare hook, the vector arbitrary code runs through on
#                     `npm install`. Install with `npm ci`.
#   min-release-age - refuse any dependency version published less than 3 days
#                     ago, so a compromised release pulled before it is caught
#                     never enters package-lock.json. Gates `npm install <pkg>`
#                     and `npm update`, not `npm ci`. Needs npm >= 11.10.0;
#                     older npm ignores it silently.
ignore-scripts=true
min-release-age=3
