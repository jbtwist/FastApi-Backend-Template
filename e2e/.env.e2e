# Environment for the end-to-end stack. Loaded by playwright.config.ts and
# passed to the backend process, where it takes precedence over backend/.env
# (pydantic-settings ranks real environment variables above the dotenv file).
#
# Every deviation from backend/.env.example is deliberate; see the comments.

# Its own database, so a test run never touches your dev data. Created on
# demand by scripts/ensure-db.mjs, migrated by scripts/start-backend.sh.
#
# No role in the URL: both asyncpg and node-postgres fall back to the OS user,
# which is how a stock Homebrew/Postgres.app install is set up. Export
# E2E_DATABASE_URL to point somewhere else without editing this file.
DATABASE_URL=postgresql+asyncpg://localhost:5432/backend_template_e2e

# Ports of its own, clear of the dev servers on 8000/8081. Sharing them would
# let Playwright's `reuseExistingServer` silently adopt a running dev backend
# and point the whole suite at the dev database.
CORS_ALLOWED_ORIGINS=http://localhost:8082
JWT_SECRET=e2e-only-secret-never-used-outside-tests
COOKIE_SECURE=false

# Short enough that a test can outlive an access token and exercise the
# refresh-on-401 path in real time (specs/silent-refresh.spec.ts).
ACCESS_TOKEN_EXP=PT10S

# A spent refresh token presented again within this window is treated as a
# racing tab, not a theft. Short, so the replay specs can wait it out.
REFRESH_TOKEN_REUSE_GRACE=PT1S

PASSWORD_STRENGTH=medium
PASSWORD_MAX_LENGTH=128

# The real check calls api.pwnedpasswords.com on every register and reset.
# Leaving it on makes the suite depend on an external service.
PASSWORD_CHECK_PWNED=false

# The limits are 3/minute on resend-verification and forgot-password; a suite
# trips those immediately. Off, the limiter's dependency is never installed,
# so no request path needs Redis.
RATE_LIMIT_ENABLED=false

# Kombu's in-process transport: `dispatch_email.delay` returns instantly and
# nothing consumes the queue. The tests read `email_outbox` directly, so no
# worker, no SMTP server, and no Redis are needed to run them.
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://

FROM_EMAIL=no-reply@backend-template.e2e
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025

API_BASE_URL=http://localhost:8100
FRONTEND_BASE_URL=http://localhost:8082
